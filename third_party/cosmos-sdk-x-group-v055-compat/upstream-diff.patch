 const unsetGroupID = 100000000000000
+
+// SharedState coordinates the minimum group ID across related legacy
+// simulation operations.
+type SharedState struct {
+	minGroupID atomic.Uint64
+}
+
+// NewSharedState returns a simulation state initialized above normal group IDs.
+func NewSharedState() *SharedState {
+	state := &SharedState{}
+	state.setMinGroupID(unsetGroupID)
+	return state
+}
+
+func (s *SharedState) getMinGroupID() uint64 {
+	return s.minGroupID.Load()
+}
+
+func (s *SharedState) setMinGroupID(id uint64) {
+	s.minGroupID.Store(id)
+}
 
