    {
      "type": "text", "id": "kv_evidence_text", "x": 98, "y": 1167, "width": 700, "height": 220,
      "text": "KVStore[pqcauth]\n├─ Params\n│  └─ enforcement / allowed_algorithms / gas / limits / pending\n├─ AccountPolicy/{owner}\n│  └─ current + H+1 pending signing/recovery key / policy_version\n├─ PQCKeyRecord/{owner}/{key_id}\n│  └─ algorithm / role / status / effective height / inactive height\n├─ AccountKeySequence/{owner}\n└─ AccountKeyHistory/{owner}/{role}", "originalText": "KVStore[pqcauth]\n├─ Params\n│  └─ enforcement / allowed_algorithms / gas / limits / pending\n├─ AccountPolicy/{owner}\n│  └─ current + H+1 pending signing/recovery key / policy_version\n├─ PQCKeyRecord/{owner}/{key_id}\n│  └─ algorithm / role / status / effective height / inactive height\n├─ AccountKeySequence/{owner}\n└─ AccountKeyHistory/{owner}/{role}",
      "fontSize": 16, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
