    {
      "type": "text", "id": "types_dir_text", "x": 1245, "y": 478, "width": 360, "height": 120,
      "text": "types/ + proto/  共识 wire format\nextension.proto → ExtensionPQCAuth\nsigning.proto → SignDoc / KeyProof /\nRecoveryDoc\ntx.proto → 7 个 Msg RPC\nstate.proto → Params / Policy / KeyRecord\ncanonical_tx.go → deterministic protobuf", "originalText": "types/ + proto/  共识 wire format\nextension.proto → ExtensionPQCAuth\nsigning.proto → SignDoc / KeyProof /\nRecoveryDoc\ntx.proto → 7 个 Msg RPC\nstate.proto → Params / Policy / KeyRecord\ncanonical_tx.go → deterministic protobuf",
      "fontSize": 15, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
