    {
      "type": "text", "id": "crypto_dir_text", "x": 120, "y": 902, "width": 325, "height": 78,
      "text": "crypto/  密码学适配层\nmldsa65.go\nCloudflare CIRCL + 严格 pk/sig 长度检查\n固定 FIPS 204 context", "originalText": "crypto/  密码学适配层\nmldsa65.go\nCloudflare CIRCL + 严格 pk/sig 长度检查\n固定 FIPS 204 context",
