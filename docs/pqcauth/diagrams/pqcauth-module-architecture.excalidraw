    {
      "type": "text", "id": "client_dir_text", "x": 120, "y": 705, "width": 325, "height": 95,
      "text": "client/  钱包与离线签名工具\nsign.go              构造 PQCSignDocV1\nbundle*.go         离线导出/导入签名包\nclient/cli          tx 与 query 命令", "originalText": "client/  钱包与离线签名工具\nsign.go              构造 PQCSignDocV1\nbundle*.go         离线导出/导入签名包\nclient/cli          tx 与 query 命令",
      "fontSize": 16, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1,
      "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 500015,
