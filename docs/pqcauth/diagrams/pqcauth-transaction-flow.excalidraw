    {
      "type": "text", "id": "payload_heading", "x": 70, "y": 335, "width": 440, "height": 30,
      "text": "1  载荷：PQC 位于 TxBody critical extension", "originalText": "1  载荷：PQC 位于 TxBody critical extension",
