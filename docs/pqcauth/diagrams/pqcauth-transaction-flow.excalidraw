    {
      "type": "rectangle", "id": "tx_payload_code", "x": 70, "y": 380, "width": 450, "height": 400,
      "strokeColor": "#1e3a5f", "backgroundColor": "#1e293b", "fillStyle": "solid", "strokeWidth": 2,
      "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 200005,
      "version": 1, "versionNonce": 200006, "isDeleted": false, "groupIds": [], "boundElements": null,
      "link": null, "locked": false, "roundness": {"type": 3}
    },
    {
      "type": "text", "id": "tx_payload_code_text", "x": 95, "y": 405, "width": 400, "height": 345,
      "text": "TxRaw\n├─ body\n│  ├─ messages[]\n│  ├─ memo / timeout_height\n│  └─ extension_options[-1]\n│     └─ ExtensionPQCAuth\n│        ├─ format_version = 1\n│        └─ signatures[]\n│           ├─ signer_index\n│           ├─ key_id / policy_version\n│           └─ ML-DSA signature\n├─ auth_info\n│  ├─ signer_infos[] / sequence\n│  └─ fee / fee_granter\n└─ signatures[]   // 经典签名", "originalText": "TxRaw\n├─ body\n│  ├─ messages[]\n│  ├─ memo / timeout_height\n│  └─ extension_options[-1]\n│     └─ ExtensionPQCAuth\n│        ├─ format_version = 1\n│        └─ signatures[]\n│           ├─ signer_index\n│           ├─ key_id / policy_version\n│           └─ ML-DSA signature\n├─ auth_info\n│  ├─ signer_infos[] / sequence\n│  └─ fee / fee_granter\n└─ signatures[]   // 经典签名",
      "fontSize": 16, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#22c55e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1,
      "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 200007,
      "version": 1, "versionNonce": 200008, "isDeleted": false, "groupIds": [], "boundElements": null,
      "link": null, "locked": false, "containerId": null, "lineHeight": 1.25
    },
    {
      "type": "text", "id": "ante_heading", "x": 610, "y": 335, "width": 520, "height": 30,
      "text": "2  Ante：廉价检查优先，经典验签后再做 ML-DSA", "originalText": "2  Ante：廉价检查优先，经典验签后再做 ML-DSA",
