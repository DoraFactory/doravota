    {
      "type": "text", "id": "sign_doc_code_text", "x": 95, "y": 950, "width": 970, "height": 180,
      "text": "PQCSignDocV1 {\n  network_id, chain_id, account_number, sequence,\n  signer_index, signer, key_id, algorithm, policy_version,\n  body_bytes_without_pqc_auth,   // 删除自身 extension，避免循环签名\n  auth_info_bytes                // fee、fee_granter、signer_infos 全部绑定\n}\nFIPS 204 context = doravota/pqcauth/tx/v1", "originalText": "PQCSignDocV1 {\n  network_id, chain_id, account_number, sequence,\n  signer_index, signer, key_id, algorithm, policy_version,\n  body_bytes_without_pqc_auth,   // 删除自身 extension，避免循环签名\n  auth_info_bytes                // fee、fee_granter、signer_infos 全部绑定\n}\nFIPS 204 context = doravota/pqcauth/tx/v1",
      "fontSize": 16, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#22c55e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1,
